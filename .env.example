# Copy to .env for Docker Compose. Never commit your real .env.
# Local uvicorn uses shell environment variables and does not read .env itself.
APP_MODE=demo
APP_URL=http://localhost:8091
SESSION_DAYS=90

# Host Nginx must use the same loopback port. Change this only if occupied.
PAIDDRIVE_PORT=8091
# Uvicorn proxy trust. For host Nginx through Docker, verify and add the actual
# immediate Docker bridge gateway IP. Never use '*' for an unverified network.
FORWARDED_ALLOW_IPS=127.0.0.1

# Compose overrides these three paths for the container's persistent mounts.
DATABASE_PATH=./data/paiddrive.sqlite3
CONTENT_ROOT=./content
MAIL_FILE_DIR=./data/outbox

# file = private local demo outbox; smtp = send real mail; disabled = no email.
# File delivery is forbidden in live mode.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Leave blank in demo mode. Live mode requires your actual ZPay provider's
# HTTPS base URL, merchant ID and key. No credentials belong in source files.
ZPAY_BASE_URL=
ZPAY_PID=
ZPAY_KEY=

# Optional absolute path readable inside the application/container.
# Example after adding the real image: /app/content/support/wechat.png
# Empty = an explicitly labelled, non-scannable placeholder image.
SUPPORT_QR_PATH=
