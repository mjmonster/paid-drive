# HOST NGINX ONLY: final HTTPS stage for a separate PaidDrive subdomain.
# Enable only after the certificate exists and APP_MODE=live is ready.
# Keep demo mode private. Use nginx.http.conf.example for ACME bootstrap first.
# Never replace the soccer analyzer's server block or the global nginx.conf.
# Render with scripts/render_deploy_config.py; then review and run nginx -t.

server {
    listen 80;
    server_name drive.example.com;

    # Keep HTTP-01 certificate renewal reachable after enabling HTTPS.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/paiddrive-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://drive.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name drive.example.com;

    ssl_certificate /etc/letsencrypt/live/drive.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drive.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/paiddrive.access.log;
    error_log /var/log/nginx/paiddrive.error.log warn;
    client_max_body_size 64k;

    # Authenticated pages, API responses and files must not enter a shared cache.
    # Never add an alias/root that exposes /app/content or the host content folder.
    location / {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
}
